{
  "name": "birdpaper-ui",
  "version": "3.0.0-alpha.47",
  "description": "A Vue 3 component library for enterprise admin interfaces. 为企业中后台而生的 Vue 3 组件库。",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "ui-library",
    "component-library",
    "components",
    "design-system",
    "typescript",
    "admin",
    "birdpaper",
    "birdpaper-ui"
  ],
  "author": "liluanhui",
  "license": "MIT",
  "homepage": "https://www.birdpaper.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liluanhui/birdpaper-ui.git"
  },
  "bugs": {
    "url": "https://github.com/liluanhui/birdpaper-ui/issues"
  },
  "sideEffects": [
    "dist/**",
    "theme/**",
    "**/*.css",
    "**/*.scss"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "types/index.d.ts",
  "web-types": "web-types.json",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./global": {
      "types": "./global.d.ts",
      "default": "./global.d.ts"
    },
    "./es": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs"
    },
    "./lib": {
      "types": "./types/index.d.ts",
      "require": "./lib/index.cjs"
    },
    "./es/*.mjs": {
      "types": "./types/*.d.ts",
      "import": "./es/*.mjs"
    },
    "./es/*": {
      "types": [
        "./types/*.d.ts",
        "./types/*/index.d.ts"
      ],
      "import": "./es/*.mjs"
    },
    "./lib/*.cjs": {
      "types": "./types/*.d.ts",
      "require": "./lib/*.cjs"
    },
    "./lib/*": {
      "types": [
        "./types/*.d.ts",
        "./types/*/index.d.ts"
      ],
      "require": "./lib/*.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "es",
    "lib",
    "theme",
    "types",
    "global.d.ts",
    "web-types.json",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "dayjs": "^1.11.3",
    "radash": "^12.1.0",
    "@vueuse/components": "^11.1.0",
    "@vueuse/core": "^11.1.0",
    "birdpaper-icon": "^1.0.0",
    "async-validator": "^4.2.5"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.22"
  }
}
