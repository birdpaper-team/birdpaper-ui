{
  "name": "birdpaper-ui",
  "version": "3.0.0-alpha.47",
  "description": "",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "types/index.d.ts",
  "web-types": "web-types.json",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./global": {
      "types": "./global.d.ts",
      "default": "./global.d.ts"
    },
    "./es": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs"
    },
    "./lib": {
      "types": "./types/index.d.ts",
      "require": "./lib/index.cjs"
    },
    "./es/*.mjs": {
      "types": "./types/*.d.ts",
      "import": "./es/*.mjs"
    },
    "./es/*": {
      "types": [
        "./types/*.d.ts",
        "./types/*/index.d.ts"
      ],
      "import": "./es/*.mjs"
    },
    "./lib/*.cjs": {
      "types": "./types/*.d.ts",
      "require": "./lib/*.cjs"
    },
    "./lib/*": {
      "types": [
        "./types/*.d.ts",
        "./types/*/index.d.ts"
      ],
      "require": "./lib/*.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "es",
    "lib",
    "theme",
    "types",
    "global.d.ts",
    "web-types.json",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "dayjs": "^1.11.3",
    "radash": "^12.1.0",
    "@vueuse/components": "^11.1.0",
    "@vueuse/core": "^11.1.0",
    "birdpaper-icon": "^0.9.0",
    "async-validator": "^4.2.5"
  },
  "devDependencies": {
    "vue": "^3.5.22"
  }
}
